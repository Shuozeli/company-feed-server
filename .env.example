DATABASE_URL=postgresql://company_feed:company_feed@localhost:55432/company_feed
POSTGRES_DB=company_feed
POSTGRES_USER=company_feed
POSTGRES_PASSWORD=company_feed
POSTGRES_PORT=55432
# URL-encode reserved URL characters in POSTGRES_USER or POSTGRES_PASSWORD.
RUST_LOG=info,feed_server=debug,feed_worker=debug
PUBLIC_FETCH_USER_AGENT="CompanyFeedServer/0.1 (+https://github.com/Shuozeli/company-feed-server; contact=you@example.com)"
# COMPANIES_CONFIG=/app/configs/companies.yaml
# EXPORT_TARGETS_CONFIG=/app/configs/export_targets.yaml
BIND_ADDR=0.0.0.0:8080
WORKER_BIND_ADDR=0.0.0.0:8081
DISCOVERY_WORKER_BIND_ADDR=0.0.0.0:8082
VALIDATION_WORKER_BIND_ADDR=0.0.0.0:8083
NEWS_EXTRACTION_WORKER_BIND_ADDR=0.0.0.0:8084
# Keep the base Compose stack loopback-only. To publish the API privately over
# Tailscale, uncomment both settings and use this host's `tailscale ip -4`.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# TAILSCALE_BIND_IP=100.64.0.1
# Tagged releases can use ghcr.io/shuozeli/company-feed-server:<version>.
# COMPANY_FEED_IMAGE=company-feed-server:local
SERVER_PORT=8080
WORKER_PORT=8081
DISCOVERY_WORKER_PORT=8082
VALIDATION_WORKER_PORT=8083
NEWS_EXTRACTION_WORKER_PORT=8084
RUN_JOBS=true
SCHEDULE_JOBS=true
WORKER_RUN_JOBS=true
WORKER_SCHEDULE_JOBS=true
DISCOVERY_RUN_JOBS=true
DISCOVERY_SCHEDULE_JOBS=true
VALIDATION_RUN_JOBS=true
VALIDATION_SCHEDULE_JOBS=false
NEWS_EXTRACTION_RUN_JOBS=true
NEWS_EXTRACTION_JOB_CONCURRENCY=1
DATABASE_MAX_CONNECTIONS=10
SCHEDULER_SCAN_SECONDS=30
DISCOVERY_QUEUE_TARGET=100
VALIDATION_QUEUE_TARGET=100
NEWS_EXTRACTION_ENABLED=false
NEWS_EXTRACTION_SOURCE_FRESHNESS_SECONDS=2592000
VALIDATION_AUTO_ACTIVATE=true
VALIDATION_PUBLIC_EXPORT=false
VALIDATION_ACTIVATION_POLICY=strict
VALIDATION_MAX_ITEM_AGE_DAYS=730
AUTO_ACTIVATION_FRESHNESS_SECONDS=3600
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
JOB_POLL_INTERVAL_MS=1000
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
DISCOVERY_REQUEST_TIMEOUT_SECONDS=15
DISCOVERY_MAX_RESPONSE_BYTES=4194304
DISCOVERY_MAX_CONCURRENCY=8
DISCOVERY_MAX_CANDIDATES=200
DISCOVERY_PROBE_COMMON_PATHS=true
DISCOVERY_ALLOW_PRIVATE_NETWORKS=false
WEB_DISCOVERY_ADAPTER_MODE=disabled
WEB_DISCOVERY_ADAPTER_URL=
WEB_DISCOVERY_ADAPTER_TOKEN=
WEB_DISCOVERY_ADAPTER_TIMEOUT_SECONDS=90
WEB_DISCOVERY_ADAPTER_MAX_RESPONSE_BYTES=1048576
WEB_DISCOVERY_ADAPTER_MAX_CANDIDATES=20
NEWS_EXTRACTION_ADAPTER_URL=
NEWS_EXTRACTION_ADAPTER_TOKEN=
NEWS_EXTRACTION_ADAPTER_TIMEOUT_SECONDS=750
NEWS_EXTRACTION_ADAPTER_MAX_RESPONSE_BYTES=1048576
NEWS_EXTRACTION_MAX_ARTICLES=20
NEWS_EXTRACTION_FETCH_TIMEOUT_SECONDS=20
NEWS_EXTRACTION_MAX_RESPONSE_BYTES=8388608
NEWS_EXTRACTION_MAX_CONCURRENCY=24
NEWS_EXTRACTION_MAX_PER_HOST_CONCURRENCY=8
NEWS_EXTRACTION_MIN_CONTENT_CHARS=200
NEWS_EXTRACTION_ALLOW_PRIVATE_NETWORKS=false
NEWS_EXTRACTION_PUBLIC_EXPORT=false
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_MAX_RESPONSE_BYTES=8388608
CRAWLER_MAX_ITEMS=500
