{
  "openapi": "3.1.2",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Company News Data",
    "version": "1.1.0",
    "description": "Read-only contract for lazy browser indexes, full-text shards, and compatible HTTP adapters.",
    "license": {
      "name": "CC0-1.0 (contract and schemas only)",
      "identifier": "CC0-1.0"
    }
  },
  "security": [],
  "servers": [
    {
      "url": "https://raw.githubusercontent.com/Shuozeli/company-news-data/main"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "operationId": "getDataIndex",
        "summary": "Bootstrap the current dataset without loading article data",
        "responses": {
          "200": {
            "description": "Current dataset pointers and counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/data-index.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/HEAD.json": {
      "get": {
        "operationId": "getArchiveHead",
        "summary": "Resolve the current archive generation",
        "responses": {
          "200": {
            "description": "Current archive head",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/head.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/manifest.json": {
      "get": {
        "operationId": "getArchiveManifest",
        "summary": "Read the current root manifest",
        "responses": {
          "200": {
            "description": "Current archive manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/archive-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/recent/manifest.json": {
      "get": {
        "operationId": "getRecentManifest",
        "summary": "List bounded newest-first article-summary pages",
        "responses": {
          "200": {
            "description": "Recent article page manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/recent-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/recent/pages/{page}.json": {
      "get": {
        "operationId": "getRecentPage",
        "summary": "Read one newest-first article-summary page",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded article-summary page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/browse-page.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/companies/manifest.json": {
      "get": {
        "operationId": "getCompanyDirectoryManifest",
        "summary": "List alphabetical company-directory buckets",
        "responses": {
          "200": {
            "description": "Company-directory manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/company-directory-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/companies/buckets/{bucket}.json": {
      "get": {
        "operationId": "getCompanyDirectoryBucket",
        "summary": "Read one alphabetical company-directory bucket",
        "parameters": [
          {
            "$ref": "#/components/parameters/DirectoryBucket"
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded company-directory bucket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/company-directory-bucket.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/categories/manifest.json": {
      "get": {
        "operationId": "getCategoryDirectoryManifest",
        "summary": "List predefined company categories and their bounded pages",
        "responses": {
          "200": {
            "description": "Category-directory manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/category-directory-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/categories/{categoryKey}/pages/{page}.json": {
      "get": {
        "operationId": "getCategoryDirectoryPage",
        "summary": "Read one bounded page of companies assigned to a category",
        "parameters": [
          {
            "$ref": "#/components/parameters/CategoryKey"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded category-directory company page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/category-directory-page.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/partitions/{year}/{month}/manifest.json": {
      "get": {
        "operationId": "getPartitionManifest",
        "summary": "Read one monthly partition manifest",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Month"
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly partition manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/partition-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/index/v1/current/partitions/{year}/{month}/shards/{prefix}.jsonl": {
      "get": {
        "operationId": "getIndexShard",
        "summary": "Read one deterministic JSONL index shard",
        "parameters": [
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Month"
          },
          {
            "name": "prefix",
            "in": "path",
            "required": true,
            "description": "The literal root or a hexadecimal document-id prefix from the partition manifest.",
            "schema": {
              "type": "string",
              "pattern": "^(?:root|[0-9a-f]{1,8})$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 newline-delimited IndexDocument objects",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/articles/v1/{companyBucket}/{companyKey}/company.json": {
      "get": {
        "operationId": "getCompanyManifest",
        "summary": "Read one company timeline manifest",
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyBucket"
          },
          {
            "$ref": "#/components/parameters/CompanyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Company metadata and bounded article pages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/company-manifest.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/articles/v1/{companyBucket}/{companyKey}/index/pages/{page}.json": {
      "get": {
        "operationId": "getCompanyArticlePage",
        "summary": "Read one newest-first company article-summary page",
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyBucket"
          },
          {
            "$ref": "#/components/parameters/CompanyKey"
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded company article-summary page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/browse-page.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/articles/v1/{companyBucket}/{companyKey}/{year}/{month}/{documentBucket}/{documentId}/record.json": {
      "get": {
        "operationId": "getArticleRecord",
        "summary": "Read canonical metadata for one archived article",
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyBucket"
          },
          {
            "$ref": "#/components/parameters/CompanyKey"
          },
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Month"
          },
          {
            "$ref": "#/components/parameters/DocumentBucket"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical article metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/v1/article-record.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/articles/v1/{companyBucket}/{companyKey}/{year}/{month}/{documentBucket}/{documentId}/article.md": {
      "get": {
        "operationId": "getArticleMarkdown",
        "summary": "Read the full normalized article as Markdown",
        "parameters": [
          {
            "$ref": "#/components/parameters/CompanyBucket"
          },
          {
            "$ref": "#/components/parameters/CompanyKey"
          },
          {
            "$ref": "#/components/parameters/Year"
          },
          {
            "$ref": "#/components/parameters/Month"
          },
          {
            "$ref": "#/components/parameters/DocumentBucket"
          },
          {
            "$ref": "#/components/parameters/DocumentId"
          }
        ],
        "responses": {
          "200": {
            "description": "UTF-8 article Markdown",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "NotFound": {
        "description": "The requested archive object does not exist in this generation."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "path",
        "required": true,
        "description": "A six-digit page number from the parent manifest.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      },
      "DirectoryBucket": {
        "name": "bucket",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(?:[a-z]|0-9|other)$"
        }
      },
      "CategoryKey": {
        "name": "categoryKey",
        "in": "path",
        "required": true,
        "description": "A normalized category key from the category-directory manifest.",
        "schema": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:uncategorized|[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{16})$"
        }
      },
      "Year": {
        "name": "year",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        }
      },
      "Month": {
        "name": "month",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^(?:0[1-9]|1[0-2])$"
        }
      },
      "CompanyBucket": {
        "name": "companyBucket",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        }
      },
      "CompanyKey": {
        "name": "companyKey",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "DocumentBucket": {
        "name": "documentBucket",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{2}$"
        }
      },
      "DocumentId": {
        "name": "documentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
